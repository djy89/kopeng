# KOPENG Server Configuration
# =============================================================================
# QUICK START — the values that matter on day one. Nothing in the second
# half of this file is part of the preview path.
# =============================================================================

# REST API
PORT=3200
# Bind loopback (the default). A non-loopback HOST refuses to boot unless BOTH
# ADMIN_API_KEY and OBSERVATION_API_KEY are set — and remote deployment is
# unsupported for the 0.x preview either way. See SECURITY.md.
HOST=127.0.0.1

# The one value worth setting on day one — where scopeless (and malformed-scope)
# writes land: `project:<name>` or `client:<name>`. Unset ⇒ they land in the
# reserved triage scope `project:_unrouted` (never `global`).
PRIMARY_SCOPE=

# ADMIN_API_KEY is auto-generated into your `.env` on first run — leave it unset.
# Precedence: non-empty launch env > non-empty .env value > generated.
# It gates every operator-mutating endpoint (memory create/update/archive/batch,
# slots, context, artifacts, graph writes, operator-config PATCH, dream
# trigger/resolve, rollback, admin promote/reindex/backup/discover/maintain).
# Observation ingestion writes are gated by OBSERVATION_API_KEY (separate,
# below), NOT this key. Reads stay public (incl. POST-shaped
# recall/search/surface/traverse).
# ADMIN_API_KEY=

# --- Defaults you rarely need to change ---

# SQLite database + local backup locations
DATABASE_PATH=./data/memory.db
BACKUP_PATH=./data/backups

# Embedding + reranker models (downloaded on first run, cached forever)
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
MODELS_CACHE_DIR=./models

# Logging
LOG_LEVEL=info
LOG_PATH=./logs

# MCP Server
MCP_SERVER_NAME=kopeng
# Server version is read from package.json and is not independently configurable.

# Memory API URL (used by MCP client to connect to REST server)
MEMORY_API_URL=http://localhost:3200

# Requests per minute per remote IP (loopback is exempt from rate limiting).
RATE_LIMIT_MAX=100

# =============================================================================
# ADVANCED — not part of the preview path. Every feature block below ships
# OFF; the remaining entries are tuning knobs with safe defaults.
# =============================================================================

# Database backend — SQLite is the supported preview backend.
# Alternative backend for the maintainer only — see docs/postgres-maintainer.md

# Neo4j (entity graph + traverse_memory tool) — optional service, OFF by default
# NEO4J_ENABLED=false
# NEO4J_URL=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=

# Redis (ephemeral context store) — optional service, OFF by default
# REDIS_ENABLED=false
# REDIS_URL=redis://localhost:6379
# REDIS_KEY_PREFIX=memory:
# REDIS_DEFAULT_TTL=3600

# MinIO (S3-compatible artifact storage) — optional service, OFF by default
# MINIO_ENABLED=false
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=memory-artifacts

# Auto-discovery pipeline (passive learning from tool-use observations).
# Shipped defaults stay OFF. `npm run wire` can add the recommended/everything
# profile values to `.env`, but never replaces an explicit assignment.
# OBSERVATION_INGESTION_ENABLED=false    # Accept and store tool-use observations
# DISCOVERY_DETECTION_ENABLED=false      # Run pattern detection on stored observations
# OBSERVATION_API_KEY=                   # Shared secret for X-API-Key auth on observation endpoints
# DISCOVERY_MIN_OCCURRENCES=3            # Minimum pattern occurrences to trigger detection
# DISCOVERY_ANALYSIS_WINDOW_HOURS=168    # Starvation fallback: trigger if unprocessed obs older than this
# OBSERVATION_RETENTION_DAYS=7           # Purge observations older than this
# OBSERVATION_MAX_INPUT_SIZE=5000        # Max characters for observation input_summary
# OBSERVATION_MAX_OUTPUT_SIZE=1024       # Max characters for observation output_summary
# OBSERVATION_MAX_ERROR_OUTPUT_SIZE=4096 # Max characters for error observation output (stack traces need room)
# DISCOVERY_MIN_ERROR_OCCURRENCES=2      # Minimum occurrences to note a recurring error pattern
# DISCOVERY_CONFIDENCE_FLOOR=0.5         # Minimum score multiplier for confidence blending in search
# OBSERVATION_MAX_TABLE_SIZE=100000      # Max observations before forced purge
# DISCOVERY_TRIGGER_EVERY_N=50           # Trigger discovery after this many new observations
# DISCOVERY_INTERVAL_MS=60000            # Scheduler check interval in milliseconds

# Memory access log retention (days); 0 = keep forever, negative values refused
# ACCESS_LOG_RETENTION_DAYS=90

# Dreaming layer (autonomous nightly consolidation) — OFF by default;
# `npm run wire -- --profile everything` can add this flag to `.env`.
# No wire profile changes the separate auto-apply operator-config gates.
# DREAMING_ENABLED=false                 # Master switch for the nightly consolidation pass
# DREAM_INTERVAL_MS=60000                # Scheduler tick interval
# DREAM_TIMEZONE=UTC                     # Operator-local timezone for quiet-hours / day boundary
# DREAM_IDLE_MINUTES=30                  # Minimum operator idle before a pass may fire
# DREAM_QUIET_START_HOUR=2               # Quiet-hours window start (local hour)
# DREAM_QUIET_END_HOUR=6                 # Quiet-hours window end (local hour)

# Dream reasoner (optional local LLM, classify-only — never writes) — OFF by default
# DREAM_REASONER_ENABLED=false           # Arm the local Ollama classifier (restart-gated)
# DREAM_REASONER_URL=http://localhost:11434
# DREAM_REASONER_MODEL=qwen3:8b
# DREAM_REASONER_TIMEOUT_MS=30000
# DREAM_REASONER_MAX_TOKENS=300

# Observability viz (scripts/viz-server.js, `npm run viz`) — local dashboard
# VIZ_PORT=8780                          # Port the viz proxy listens on
# VIZ_HOST=127.0.0.1                     # Loopback by default. Widening this exposes the viz to the network
# VIZ_ALLOW_REMOTE_ADMIN=                # Set to 1 ONLY to permit mutations from a remotely-bound viz. Without it a
#                                        # non-loopback bind is read-only: the proxy 403s every non-GET method
