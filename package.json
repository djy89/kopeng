{
  "name": "kopeng",
  "version": "1.1.0",
  "description": "Persistent memory system with semantic search, accessible via MCP and REST API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "kopeng": "dist/cli/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djy89/kopeng.git"
  },
  "homepage": "https://github.com/djy89/kopeng#readme",
  "bugs": {
    "url": "https://github.com/djy89/kopeng/issues"
  },
  "files": [
    "dist",
    "scripts/hooks",
    "scripts/viz-server.js",
    "viz",
    ".env.example",
    "SETUP.md",
    "SECURITY.md",
    "docs/codex-setup.md",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:mcp": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:mcp": "node dist/index.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "migrate": "tsx scripts/migrate-from-files.ts",
    "eval": "tsx scripts/run-eval.ts",
    "eval:seed": "tsx scripts/seed-eval-dataset.ts",
    "eval:baseline": "tsx scripts/run-eval.ts --rerank false",
    "eval:reranked": "tsx scripts/run-eval.ts --rerank true",
    "eval:report": "tsx scripts/generate-eval-report.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "migrate:postgres": "tsx scripts/migrate-sqlite-to-postgres.ts",
    "migrate:verify": "tsx scripts/verify-migration.ts",
    "backfill:graph": "tsx scripts/backfill-graph.ts",
    "promote": "tsx scripts/run-promotion.ts",
    "promote:dry": "tsx scripts/run-promotion.ts --dry-run",
    "discover": "tsx scripts/run-discovery.ts",
    "discover:maintain": "tsx scripts/run-discovery.ts --maintain",
    "import:jsonl": "tsx scripts/import-jsonl.ts",
    "import:jsonl:dry": "tsx scripts/import-jsonl.ts --dry-run",
    "metric:proactive": "tsx scripts/metric-proactive-use.ts",
    "dream:replay": "tsx scripts/replay-dream.ts",
    "dream:effectiveness": "tsx scripts/dream-effectiveness.ts",
    "dream:drill": "tsx scripts/dream-drill.ts",
    "eval:reasoner": "tsx scripts/eval-reasoner-prompt.ts",
    "eval:adversarial": "tsx scripts/eval-reasoner-adversarial.ts",
    "eval:nli": "tsx scripts/eval-nli-classifier.ts",
    "viz": "node scripts/viz-server.js",
    "metric:surfacing": "tsx scripts/metric-surfacing.ts",
    "metric:adherence": "tsx scripts/metric-adherence.ts",
    "triage:anchors": "tsx scripts/triage-anchors.ts",
    "triage:anchors:live": "tsx scripts/triage-anchors-live.ts",
    "analyze:type-decay": "tsx scripts/analyze-type-decay.ts",
    "snapshot:corpus-health": "tsx scripts/ops/corpus-health-snapshot.ts",
    "propose:scope-aliases": "tsx scripts/ops/propose-scope-aliases.ts",
    "migrate:scope-aliases": "tsx scripts/ops/migrate-scope-aliases.ts",
    "migrate:anchors": "tsx scripts/ops/migrate-anchors-to-lock.ts",
    "reconcile:archived": "tsx scripts/ops/reconcile-archived-columns.ts",
    "canary": "tsx src/cli/recall-canary.ts",
    "wire": "tsx src/cli/wire-client.ts",
    "doctor": "tsx src/cli/doctor.ts",
    "heartbeats": "tsx scripts/ops/heartbeats-report.ts",
    "backup": "tsx scripts/ops/backup-local.ts",
    "clean:client": "node scripts/ops/clean-client.mjs",
    "restore:verify": "tsx scripts/ops/backup-local.ts --verify",
    "prepublishOnly": "npm run build && vitest run tests/unit"
  },
  "author": "djy89 (https://github.com/djy89)",
  "license": "BUSL-1.1",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1010.0",
    "@aws-sdk/s3-request-presigner": "^3.1010.0",
    "@fastify/rate-limit": "^10.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@xenova/transformers": "^2.17.0",
    "better-sqlite3": "~12.9.0",
    "dotenv": "^16.4.1",
    "fastify": "^5.0.0",
    "ioredis": "^5.10.0",
    "neo4j-driver": "^5.28.3",
    "pg": "^8.20.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.11.5",
    "@types/pg": "^8.18.0",
    "@vitest/coverage-v8": "^3.2.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
